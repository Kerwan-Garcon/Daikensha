{
  "name": "coucou-windows",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "node scripts/tauri.mjs",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
